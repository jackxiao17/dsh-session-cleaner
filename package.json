{
  "name": "dsh-session-cleaner",
  "version": "0.8.0",
  "description": "DSH 会话清理插件：把冷会话搬进可恢复回收站，支持标题/正文搜索、恢复与彻底删除。删除时清理工作区记账、置顶、归档和投影缓存；活动定时任务暂停而非删除，恢复时还原；实时会话、活动后台任务与 SQLite/自定义 sessions root 会安全拒绝。已适配 DeepSeek Harness 0.2.3-alpha.2。",
  "about": "DSH 会话清理：冷会话回收到可恢复回收站，活动任务暂停/恢复，实时会话与未知后端安全拒绝；已适配 DSH 0.2.3-alpha.2 | DSH session cleaner with reversible recycle bin, pausable schedules, and fail-closed live/backend checks for DSH 0.2.3-alpha.2",
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "plugin",
    "session",
    "delete",
    "recycle-bin",
    "cleaner"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jackxiao17/dsh-session-cleaner.git"
  },
  "homepage": "https://github.com/jackxiao17/dsh-session-cleaner#readme",
  "bugs": {
    "url": "https://github.com/jackxiao17/dsh-session-cleaner/issues"
  },
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json",
    "./locale/*.md": "./locale/*.md",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "icon.svg",
    "locale",
    "assets",
    "screenshots.json",
    "README.md",
    "README.en.md"
  ],
  "scripts": {
    "test": "node scripts/verify.mjs && node scripts/verify-safety.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "engines": {
    "node": "^24.22.3 || >=26.13.1",
    "dsh": ">=0.2.2-rc.2 <0.3.0"
  }
}

