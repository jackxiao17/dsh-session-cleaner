{
  "name": "dsh-session-cleaner",
  "version": "0.6.5",
  "description": "DSH 会话清理插件：侧栏会话「···」菜单一键移入回收站，回收站支持搜索、恢复与彻底删除（日志目录 + 记账 + 投影缓存 + 插件注解的完整清理）；对话中的会话会先结束当前回答再移入。",
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "session",
    "delete",
    "cleaner"
  ],
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "cordis": ">=4.0.0-rc <5"
  },
  "engines": {
    "node": "^22.15.0 || >=24.0.0"
  }
}
